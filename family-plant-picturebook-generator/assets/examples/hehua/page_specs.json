  "pages":[
    {"file":"01-cover.png","pageRole":"cover","characters":["qiqi","mom"],"sceneSeason":"summer","imagegenPrompt":{"text":"Native portrait 3:4 summer Shanghai lotus pond cover. Exact text: 七七的植物世界 No.32; 荷花; 池塘里，花和叶子一起伸向夏天. True Nelumbo nucifera, large flowers and round leaves above water; no water lilies, no pseudo-text.","references":[{"path":"assets/characters/qiqi-and-mom-reference.png","role":"character identity only"},{"path":"continuity/qiqi-outfit-sheet.png","role":"Qiqi outfit and accessory continuity"},{"path":"continuity/mom-outfit-sheet.png","role":"Mom outfit and accessory continuity"},{"path":"assets/examples/series-reference/final_pages/01-cover.png","role":"series style and composition only"}]},"textBlocks":[{"id":"series","text":"七七的植物世界 No.32","role":"series-label","container":"ribbon-banner","placement":"upper-center","alignment":"center","maxLines":1,"priority":"required"},{"id":"title","text":"荷花","role":"title","container":"open-title-area","placement":"center","alignment":"center","maxLines":1,"priority":"required"},{"id":"hook","text":"池塘里，花和叶子一起伸向夏天","role":"caption","container":"subtitle-area","placement":"center","alignment":"center","maxLines":1,"priority":"required"}],"qaHints":{"mustShowText":true,"mustMatchRole":true,"seasonCheck":true}},
    {"file":"02-meet.png","pageRole":"first encounter","characters":["qiqi","mom"],"sceneSeason":"summer","imagegenPrompt":{"text":"Summer lotus pond first encounter, one floating leaf and one emergent leaf. Exact text: 妈妈，池塘里的花怎么站得这么高？ 这是荷花，也叫莲。你看，花梗把花托到了水面上方。 那旁边的大圆叶子呢？ 有的叶子浮在水面，有的叶子也会高高伸出来。","references":[{"path":"assets/characters/qiqi-and-mom-reference.png","role":"character identity only"},{"path":"continuity/qiqi-outfit-sheet.png","role":"Qiqi outfit and accessory continuity"},{"path":"continuity/mom-outfit-sheet.png","role":"Mom outfit and accessory continuity"},{"path":"assets/examples/series-reference/final_pages/02-meet.png","role":"series style and dialogue composition only"}]},"textBlocks":[{"id":"q1","text":"妈妈，池塘里的花怎么站得这么高？","role":"dialogue","container":"speech-bubble","placement":"upper-left","alignment":"left","maxLines":2,"priority":"required"},{"id":"m1","text":"这是荷花，也叫莲。你看，花梗把花托到了水面上方。","role":"dialogue","container":"speech-bubble","placement":"upper-right","alignment":"left","maxLines":3,"priority":"required"},{"id":"q2","text":"那旁边的大圆叶子呢？","role":"dialogue","container":"caption-panel","placement":"lower-left","alignment":"left","maxLines":1,"priority":"required"},{"id":"m2","text":"有的叶子浮在水面，有的叶子也会高高伸出来。","role":"dialogue","container":"caption-panel","placement":"lower-right","alignment":"left","maxLines":2,"priority":"required"}],"qaHints":{"mustShowText":true,"mustMatchRole":true,"seasonCheck":true}},
    {"file":"03-name.png","pageRole":"name origin","characters":["qiqi","mom"],"sceneSeason":"summer","imagegenPrompt":{"text":"Summer lotus pond name page. Exact text: 它明明长在水里，为什么叫荷花？ 大家常把莲的花叫作“荷花”，也会叫它莲花。古诗里还会叫它“菡萏”“芙蕖”。 原来一朵花，有好几个名字！ Do not invent etymology or folklore.","references":[{"path":"assets/characters/qiqi-and-mom-reference.png","role":"character identity only"},{"path":"continuity/qiqi-outfit-sheet.png","role":"Qiqi outfit continuity"},{"path":"continuity/mom-outfit-sheet.png","role":"Mom outfit continuity"},{"path":"assets/examples/series-reference/final_pages/03-name.png","role":"series style and typography only"}]},"textBlocks":[{"id":"q1","text":"它明明长在水里，为什么叫荷花？","role":"dialogue","container":"speech-bubble","placement":"upper-left","alignment":"left","maxLines":2,"priority":"required"},{"id":"m1","text":"大家常把莲的花叫作“荷花”，也会叫它莲花。古诗里还会叫它“菡萏”“芙蕖”。","role":"dialogue","container":"caption-panel","placement":"right","alignment":"left","maxLines":4,"priority":"required"},{"id":"q2","text":"原来一朵花，有好几个名字！","role":"dialogue","container":"speech-bubble","placement":"lower-left","alignment":"left","maxLines":1,"priority":"required"}],"qaHints":{"mustShowText":true,"mustMatchRole":true,"seasonCheck":true}},
    {"file":"04-plant-secret.png","pageRole":"plant secret","characters":["qiqi","mom"],"sceneSeason":"summer after rain","imagegenPrompt":{"text":"After-rain lotus leaf close observation. Exact text: 咦，水珠在叶子上滚走了！ 莲叶的表面不容易让水黏住，水珠就容易滚下来，还能带走一些灰尘。 莲叶像一把会让水珠滑走的小伞。 Droplets must be on Nelumbo leaf, not water lily.","references":[{"path":"assets/characters/qiqi-and-mom-reference.png","role":"character identity only"},{"path":"continuity/qiqi-outfit-sheet.png","role":"Qiqi outfit continuity"},{"path":"continuity/mom-outfit-sheet.png","role":"Mom outfit continuity"},{"path":"assets/examples/series-reference/final_pages/04-plant-secret.png","role":"series style and botanical close-up composition only"}]},"textBlocks":[{"id":"q1","text":"咦，水珠在叶子上滚走了！","role":"dialogue","container":"speech-bubble","placement":"upper-left","alignment":"left","maxLines":1,"priority":"required"},{"id":"m1","text":"莲叶的表面不容易让水黏住，水珠就容易滚下来，还能带走一些灰尘。","role":"dialogue","container":"caption-panel","placement":"right","alignment":"left","maxLines":3,"priority":"required"},{"id":"q2","text":"莲叶像一把会让水珠滑走的小伞。","role":"dialogue","container":"speech-bubble","placement":"lower-center","alignment":"center","maxLines":1,"priority":"required"}],"qaHints":{"mustShowText":true,"mustMatchRole":true,"seasonCheck":true}},
    {"file":"05-closeup.png","pageRole":"close-up","characters":["qiqi","mom"],"sceneSeason":"late summer","imagegenPrompt":{"text":"Late-summer lotus receptacle close-up. Exact text: 近近看，花谢以后，花托会慢慢变大。 它像一个倒过来的小圆锥，上面还有一个个小孔。 每个孔里都嵌着一颗坚果。8—10 月，是它的果期。 Show the true inverted-cone honeycomb lotus receptacle.","references":[{"path":"assets/characters/qiqi-and-mom-reference.png","role":"character identity only"},{"path":"continuity/qiqi-outfit-sheet.png","role":"Qiqi outfit continuity"},{"path":"continuity/mom-outfit-sheet.png","role":"Mom outfit continuity"},{"path":"assets/examples/series-reference/final_pages/05-closeup.png","role":"series style and botanical close-up composition only"}]},"textBlocks":[{"id":"m1","text":"近近看，花谢以后，花托会慢慢变大。","role":"dialogue","container":"speech-bubble","placement":"upper-left","alignment":"left","maxLines":2,"priority":"required"},{"id":"q1","text":"它像一个倒过来的小圆锥，上面还有一个个小孔。","role":"dialogue","container":"caption-panel","placement":"right","alignment":"left","maxLines":2,"priority":"required"},{"id":"m2","text":"每个孔里都嵌着一颗坚果。8—10 月，是它的果期。","role":"dialogue","container":"caption-panel","placement":"lower-center","alignment":"center","maxLines":2,"priority":"required"}],"qaHints":{"mustShowText":true,"mustMatchRole":true,"seasonCheck":true}},
    {"file":"06-compare.png","pageRole":"comparison","characters":["qiqi","mom"],"sceneSeason":"summer","imagegenPrompt":{"text":"Split comparison with only lotus and water lily. Exact text: 这朵也是水里的花，是不是睡莲？ 不是哦。睡莲的叶和花通常贴着或浮在水面；莲的花和叶常常高出水面。 看花托和高度，就能先分一分啦！ 莲  Nelumbo nucifera    睡莲  Nymphaea spp. Show lotus above water and water lily floating.","references":[{"path":"assets/characters/qiqi-and-mom-reference.png","role":"character identity only"},{"path":"continuity/qiqi-outfit-sheet.png","role":"Qiqi outfit continuity"},{"path":"continuity/mom-outfit-sheet.png","role":"Mom outfit continuity"},{"path":"assets/examples/series-reference/final_pages/06-compare.png","role":"series style and comparison composition only"}]},"textBlocks":[{"id":"q1","text":"这朵也是水里的花，是不是睡莲？","role":"dialogue","container":"speech-bubble","placement":"upper-left","alignment":"left","maxLines":2,"priority":"required"},{"id":"m1","text":"不是哦。睡莲的叶和花通常贴着或浮在水面；莲的花和叶常常高出水面。","role":"dialogue","container":"caption-panel","placement":"right","alignment":"left","maxLines":3,"priority":"required"},{"id":"q2","text":"看花托和高度，就能先分一分啦！","role":"dialogue","container":"speech-bubble","placement":"lower-center","alignment":"center","maxLines":1,"priority":"required"},{"id":"labels","text":"莲  Nelumbo nucifera    睡莲  Nymphaea spp.","role":"label","container":"notebook-card","placement":"lower-third","alignment":"center","maxLines":2,"priority":"required"}],"qaHints":{"mustShowText":true,"mustMatchRole":true,"seasonCheck":true}},
    {"file":"07-ending.png","pageRole":"warm ending","characters":["qiqi","mom"],"sceneSeason":"late summer golden hour","imagegenPrompt":{"text":"Warm late-summer Shanghai pond ending. Exact text: 我把今天看到的花、叶子和花托画进观察本里。 真好。我们不摘花、不挖藕、不取莲子，只用眼睛、相机和画笔认识它。 下次夏天，我们再来看看池塘里的莲！ Show observation, no picked flowers or dug rhizomes.","references":[{"path":"assets/characters/qiqi-and-mom-reference.png","role":"character identity only"},{"path":"continuity/qiqi-outfit-sheet.png","role":"Qiqi outfit continuity"},{"path":"continuity/mom-outfit-sheet.png","role":"Mom outfit continuity"},{"path":"assets/examples/series-reference/final_pages/07-ending.png","role":"series style and warm ending composition only"}]},"textBlocks":[{"id":"q1","text":"我把今天看到的花、叶子和花托画进观察本里。","role":"dialogue","container":"speech-bubble","placement":"upper-left","alignment":"left","maxLines":2,"priority":"required"},{"id":"m1","text":"真好。我们不摘花、不挖藕、不取莲子，只用眼睛、相机和画笔认识它。","role":"dialogue","container":"caption-panel","placement":"lower-right","alignment":"left","maxLines":3,"priority":"required"},{"id":"q2","text":"下次夏天，我们再来看看池塘里的莲！","role":"dialogue","container":"speech-bubble","placement":"upper-right","alignment":"left","maxLines":2,"priority":"required"}],"qaHints":{"mustShowText":true,"mustMatchRole":true,"seasonCheck":true}}
  ]
